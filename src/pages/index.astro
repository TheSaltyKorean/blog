---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import Pagination from '../components/Pagination.astro';
import { siteConfig } from '../data/siteConfig';

const PAGE_SIZE = 9;

const posts = (await getCollection('blog', ({ data }) => data.draft !== true))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const pageOne = posts.slice(0, PAGE_SIZE);
const lastPage = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const nextUrl = lastPage > 1 ? '/page/2/' : undefined;
---
<BaseLayout>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 pt-16 pb-10">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">{siteConfig.title}</h1>
    <p class="mt-4 text-lg text-[var(--color-ink-soft)] max-w-2xl">
      {siteConfig.tagline}
    </p>
    <p class="mt-4 text-[var(--color-muted)] max-w-2xl">
      {siteConfig.author.bio}
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {pageOne.map((post) => <BlogCard post={post} />)}
    </div>

    <Pagination currentPage={1} lastPage={lastPage} nextUrl={nextUrl} />
  </section>
</BaseLayout>
