---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — Randy Walker" description="The page you're looking for can't be found." noindex={true}>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-24 text-center">
    <p class="text-7xl sm:text-8xl font-bold tracking-tight text-[var(--color-accent)]">404</p>
    <h1 class="mt-4 text-2xl">Page not found</h1>
    <p class="mt-3 text-[var(--color-muted)]">
      The page you're looking for doesn't exist or has moved.
    </p>
    <p class="mt-8">
      <a href="/" class="inline-block px-5 py-2.5 bg-[var(--color-accent)] text-white font-medium rounded-md no-underline hover:bg-[var(--color-accent-hover)] transition-colors">
        Back to home
      </a>
    </p>
  </section>
</BaseLayout>
