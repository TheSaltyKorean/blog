---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import Pagination from '../../components/Pagination.astro';

export async function getStaticPaths() {
  const PAGE_SIZE = 9;
  const posts = (await getCollection('blog', ({ data }) => data.draft !== true))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  const lastPage = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
  const paths = [];
  // Page 1 lives at /, so pages/[page] covers 2..lastPage
  for (let p = 2; p <= lastPage; p++) {
    const start = (p - 1) * PAGE_SIZE;
    paths.push({
      params: { page: String(p) },
      props: {
        pagePosts: posts.slice(start, start + PAGE_SIZE),
        currentPage: p,
        lastPage,
      },
    });
  }
  return paths;
}

const { pagePosts, currentPage, lastPage } = Astro.props;
const prevUrl = currentPage === 2 ? '/' : `/page/${currentPage - 1}/`;
const nextUrl = currentPage < lastPage ? `/page/${currentPage + 1}/` : undefined;
const title = `Page ${currentPage}`;
const description = `Blog archive page ${currentPage} of ${lastPage} — posts by Randy Walker.`;
---
<BaseLayout title={title} description={description}>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-16 pb-16">
    <header class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">All posts</h1>
      <p class="mt-1 text-sm text-[var(--color-muted)]">Page {currentPage} of {lastPage}</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {pagePosts.map((post) => <BlogCard post={post} />)}
    </div>

    <Pagination currentPage={currentPage} lastPage={lastPage} prevUrl={prevUrl} nextUrl={nextUrl} />
  </section>
</BaseLayout>
