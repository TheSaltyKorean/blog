---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Contact Randy Walker';
const description = 'Get in touch with Randy Walker. Reach out with questions about technology leadership, consulting, or speaking engagements.';

// Web3Forms identifies the inbox by opaque access key, so no email address is
// ever shipped in the served HTML. The key lives in the WEB3FORMS_KEY repo
// secret and is injected at build time (see .github/workflows/deploy.yml).
// If it is missing, render the LinkedIn fallback rather than a form that
// silently drops messages.
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---
<BaseLayout title={title} description={description}>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="text-center">Get in Touch</h1>
    <p class="text-center text-[var(--color-ink-soft)]">
      Have a question, want to collaborate, or just want to say hi? Fill out the form below and I'll get back to you.
    </p>

    {accessKey ? (
    <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="mt-8 space-y-4">
      <input type="hidden" name="access_key" value={accessKey} />
      <input type="hidden" name="subject" value="Contact from thesaltykorean.com" />
      <input type="hidden" name="from_name" value="thesaltykorean.com" />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" aria-hidden="true" />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <label class="block">
          <span class="sr-only">Your name</span>
          <input type="text" name="name" required placeholder="Your Name *" class="w-full px-3.5 py-2.5 border border-[var(--color-rule)] rounded-md bg-[var(--color-surface-soft)] text-[var(--color-ink)] placeholder:text-[var(--color-muted)] focus:outline-none focus:border-[var(--color-accent)] transition-colors" />
        </label>
        <label class="block">
          <span class="sr-only">Your email</span>
          <input type="email" name="email" required placeholder="Your Email *" class="w-full px-3.5 py-2.5 border border-[var(--color-rule)] rounded-md bg-[var(--color-surface-soft)] text-[var(--color-ink)] placeholder:text-[var(--color-muted)] focus:outline-none focus:border-[var(--color-accent)] transition-colors" />
        </label>
      </div>

      <label class="block">
        <span class="sr-only">Subject</span>
        <input type="text" name="topic" placeholder="Subject" class="w-full px-3.5 py-2.5 border border-[var(--color-rule)] rounded-md bg-[var(--color-surface-soft)] text-[var(--color-ink)] placeholder:text-[var(--color-muted)] focus:outline-none focus:border-[var(--color-accent)] transition-colors" />
      </label>

      <label class="block">
        <span class="sr-only">Your message</span>
        <textarea name="message" rows="6" required placeholder="Your Message *" class="w-full px-3.5 py-2.5 border border-[var(--color-rule)] rounded-md bg-[var(--color-surface-soft)] text-[var(--color-ink)] placeholder:text-[var(--color-muted)] focus:outline-none focus:border-[var(--color-accent)] transition-colors"></textarea>
      </label>

      <div class="text-center">
        <button id="contact-submit" type="submit" class="inline-block px-6 py-3 bg-[var(--color-accent)] text-[var(--color-accent-ink)] font-medium rounded-md no-underline hover:bg-[var(--color-accent-hover)] transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
          Send Message
        </button>
      </div>

      <p id="contact-status" role="status" aria-live="polite" class="hidden text-center text-sm"></p>
    </form>

    <div id="contact-success" hidden class="mt-8 text-center">
      <p class="text-lg font-medium text-[var(--color-ink)]">Message sent.</p>
      <p class="mt-2 text-[var(--color-ink-soft)]">
        Thanks for reaching out &mdash; it landed in my inbox and I read everything.
        I usually reply within a couple of days.
      </p>
      <p class="mt-6 text-sm">
        <a href="/">Back to the blog</a>
        <span class="text-[var(--color-faint)]"> &middot; </span>
        <a href="https://www.linkedin.com/in/randywalker1/" target="_blank" rel="noopener">Connect on LinkedIn</a>
      </p>
    </div>
    ) : (
    <p class="mt-8 text-center text-[var(--color-ink-soft)]">
      The contact form is temporarily unavailable. The quickest way to reach me is
      <a href="https://www.linkedin.com/in/randywalker1/" target="_blank" rel="noopener"> on LinkedIn</a>.
    </p>
    )}

    <div class="mt-12 pt-8 border-t border-[var(--color-rule)] grid grid-cols-1 sm:grid-cols-3 gap-6 text-center text-sm">
      <div>
        <h3 class="font-semibold text-base">Location</h3>
        <p class="text-[var(--color-muted)]">Austin, Texas</p>
      </div>
      <div>
        <h3 class="font-semibold text-base">LinkedIn</h3>
        <p><a href="https://www.linkedin.com/in/randywalker1/" target="_blank" rel="noopener">Connect on LinkedIn</a></p>
      </div>
      <div>
        <h3 class="font-semibold text-base">Social</h3>
        <p><a href="https://twitter.com/TheSaltyKorean" target="_blank" rel="noopener">@TheSaltyKorean</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Progressive enhancement: submit over fetch so the visitor stays on
  // thesaltykorean.com and sees our own confirmation instead of the
  // Web3Forms-hosted success page. Without JS the form still does a plain
  // POST to the same endpoint, which works — it just leaves the site.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const button = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const status = document.getElementById('contact-status');
  const success = document.getElementById('contact-success');

  if (form && button && status && success) {
    const label = button.textContent;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      button.disabled = true;
      button.textContent = 'Sending\u2026';
      status.className = 'text-center text-sm text-[var(--color-muted)]';
      status.textContent = '';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const result = await response.json().catch(() => ({}));

        if (response.ok && result.success) {
          form.hidden = true;
          success.hidden = false;
          success.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }

        throw new Error(result.message || 'Submission failed');
      } catch {
        // Never strand the message: say so plainly and offer another route.
        status.className = 'text-center text-sm text-[var(--color-accent)]';
        status.textContent =
          "That didn't go through. Please try again, or reach me on LinkedIn.";
        button.disabled = false;
        button.textContent = label;
      }
    });
  }
</script>
