---
import BaseLayout from './BaseLayout.astro';
import { slugify, displayName } from '../utils/slugify';
import { bespokeImage } from '../utils/postImage';

interface Props {
  frontmatter: {
    title: string;
    date: Date;
    author: string;
    categories: string[];
    tags: string[];
    permalink: string;
    meta_title?: string;
    meta_description?: string;
    post_image?: string;
  };
  /** Resolved meta description; falls back to frontmatter.meta_description. */
  description?: string;
  /** Whole minutes, computed from the body by the page that has it. */
  readingTime?: number;
}

const { frontmatter, description, readingTime } = Astro.props;

const published = new Date(frontmatter.date);
const primaryCategory = frontmatter.categories[0];
const postUrl = new URL(frontmatter.permalink, 'https://thesaltykorean.com').href;

const article = {
  headline: frontmatter.title,
  description,
  url: postUrl,
  image: frontmatter.post_image,
  datePublished: published.toISOString(),
  keywords: frontmatter.tags,
  section: primaryCategory,
};

// Home > Category > Post. Category tier only when the post declares one, so we
// never emit a crumb pointing at a page that does not exist.
const breadcrumbs = [
  { name: 'Home', url: '/' },
  ...(primaryCategory
    ? [{ name: displayName(primaryCategory), url: `/category/${slugify(primaryCategory)}/` }]
    : []),
  { name: frontmatter.title, url: frontmatter.permalink },
];

const heroImage = bespokeImage(frontmatter.post_image);
const stamp = `${published.getFullYear()}.${String(published.getMonth() + 1).padStart(2, '0')}.${String(published.getDate()).padStart(2, '0')}`;

const formattedDate = new Date(frontmatter.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout
  title={frontmatter.meta_title || frontmatter.title}
  description={description || frontmatter.meta_description}
  canonical={frontmatter.permalink}
  ogImage={frontmatter.post_image}
  article={article}
  breadcrumbs={breadcrumbs}
>
  <div id="reading-progress-track" class="sticky top-[68px] z-40 h-0.5 bg-[var(--color-rule-soft)]">
    <div id="reading-progress" class="h-0.5 w-0 bg-gradient-to-r from-[var(--color-accent)] to-[#7ee3f0]"></div>
  </div>

  <article>
    <!-- title block -->
    <header class="relative overflow-hidden border-b border-[var(--color-rule-soft)]">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-[420px] left-1/2 -ml-[500px] w-[1000px] h-[700px]"
        style="background: radial-gradient(ellipse at center, rgba(90,215,232,0.10) 0%, rgba(13,15,18,0) 68%);"
      ></div>

      <div class="relative max-w-[760px] mx-auto px-5 sm:px-10 pt-10 sm:pt-14 pb-10 sm:pb-13">
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 mb-7 font-[family-name:var(--font-mono)] text-xs tracking-wide text-[var(--color-muted)]">
          <a href="/" class="no-underline text-[var(--color-muted)] hover:text-[var(--color-accent)]">Home</a>
          {primaryCategory && (
            <>
              <span class="text-[#3a424d]">/</span>
              <a href={`/category/${slugify(primaryCategory)}/`} class="no-underline text-[var(--color-muted)] hover:text-[var(--color-accent)]">
                {displayName(primaryCategory)}
              </a>
            </>
          )}
        </nav>

        {frontmatter.categories.length > 0 && (
          <ul class="flex flex-wrap gap-2 mb-5" aria-label="Categories">
            {frontmatter.categories.slice(0, 3).map((cat) => (
              <li>
                <a
                  href={`/category/${slugify(cat)}/`}
                  class="inline-block font-[family-name:var(--font-mono)] text-[11px] font-medium tracking-[0.1em] uppercase no-underline text-[var(--color-accent)] bg-[rgba(90,215,232,0.1)] border border-[rgba(90,215,232,0.22)] rounded px-2.5 py-1 hover:bg-[rgba(90,215,232,0.18)]"
                >
                  {cat}
                </a>
              </li>
            ))}
          </ul>
        )}

        <h1 class="!mb-0 text-[29px] sm:text-[40px] lg:text-[46px] font-semibold leading-[1.12] tracking-[-0.025em] text-[var(--color-ink-bright)] text-pretty">
          {frontmatter.title}
        </h1>

        <div class="flex flex-wrap items-center gap-x-3.5 gap-y-1 mt-7 font-[family-name:var(--font-mono)] text-xs tracking-wide text-[var(--color-muted)]">
          <span class="text-[var(--color-ink-soft)]">{frontmatter.author}</span>
          <span class="text-[#3a424d]">·</span>
          <time datetime={published.toISOString()}>{stamp}</time>
          {readingTime && (
            <>
              <span class="text-[#3a424d]">·</span>
              <span>{readingTime} min read</span>
            </>
          )}
        </div>
      </div>
    </header>

    {heroImage && (
      <div class="max-w-[900px] mx-auto px-5 sm:px-10 pt-9 sm:pt-10">
        <img
          src={heroImage}
          alt={frontmatter.title}
          width="820"
          height="462"
          class="w-full aspect-[16/9] object-cover rounded-[10px] border border-[var(--color-rule)]"
        />
      </div>
    )}

    <div class="max-w-[760px] mx-auto px-5 sm:px-10 pt-10 sm:pt-12">
      <div class="prose-content">
        <slot />
      </div>

      {frontmatter.tags.length > 0 && (
        <footer class="mt-12 pt-8 border-t border-[var(--color-rule-soft)]">
          <h2 class="!mt-0 !mb-4 font-[family-name:var(--font-mono)] text-[11px] font-semibold tracking-[0.14em] uppercase text-[var(--color-muted)]">
            Tagged
          </h2>
          <ul class="flex flex-wrap gap-2" aria-label="Tags">
            {frontmatter.tags.map((tag) => (
              <li>
                <a
                  href={`/tag/${slugify(tag)}/`}
                  class="inline-block font-[family-name:var(--font-mono)] text-xs no-underline text-[var(--color-ink-soft)] border border-[var(--color-rule)] rounded-[5px] px-3 py-1.5 hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
                >
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        </footer>
      )}

      <nav class="mt-12 pt-8 border-t border-[var(--color-rule-soft)]">
        <a
          href="/"
          class="inline-flex items-center gap-2.5 h-12 px-6 rounded-md no-underline border border-[#2c3540] text-[15px] font-medium text-[var(--color-ink)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
          All posts
        </a>
      </nav>
    </div>
  </article>

  <script>
    const bar = document.getElementById('reading-progress');
    const article = document.querySelector('article');
    if (bar && article) {
      const update = () => {
        const start = article.offsetTop;
        const total = article.offsetHeight - window.innerHeight;
        const seen = window.scrollY - start;
        const pct = total > 0 ? Math.min(100, Math.max(0, (seen / total) * 100)) : 0;
        bar.style.width = pct + '%';
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
    }
  </script>
</BaseLayout>
