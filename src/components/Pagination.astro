---
interface Props {
  currentPage: number;
  lastPage: number;
  prevUrl?: string;
  nextUrl?: string;
}

const { currentPage, lastPage, prevUrl, nextUrl } = Astro.props;
---
{lastPage > 1 && (
  <nav class="mt-12 flex items-center justify-center gap-3 font-[family-name:var(--font-mono)] text-sm" aria-label="Pagination">
    {prevUrl ? (
      <a href={prevUrl} class="px-4 h-11 inline-flex items-center text-sm font-medium text-[var(--color-ink-soft)] border border-[var(--color-rule)] rounded-md hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] no-underline transition-colors">
        ← Newer
      </a>
    ) : (
      <span class="px-4 h-11 inline-flex items-center text-sm font-medium text-[var(--color-muted)] bg-[var(--color-surface-soft)] border border-[var(--color-rule)] rounded-md cursor-not-allowed opacity-50">
        ← Newer
      </span>
    )}
    <span class="text-sm text-[var(--color-muted)]">Page {currentPage} of {lastPage}</span>
    {nextUrl ? (
      <a href={nextUrl} class="px-4 h-11 inline-flex items-center text-sm font-medium text-[var(--color-ink-soft)] border border-[var(--color-rule)] rounded-md hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] no-underline transition-colors">
        Older →
      </a>
    ) : (
      <span class="px-4 h-11 inline-flex items-center text-sm font-medium text-[var(--color-muted)] bg-[var(--color-surface-soft)] border border-[var(--color-rule)] rounded-md cursor-not-allowed opacity-50">
        Older →
      </span>
    )}
  </nav>
)}
