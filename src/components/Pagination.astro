---
interface Props {
  currentPage: number;
  lastPage: number;
  prevUrl?: string;
  nextUrl?: string;
}

const { currentPage, lastPage, prevUrl, nextUrl } = Astro.props;
---
{lastPage > 1 && (
  <nav class="mt-12 flex items-center justify-center gap-3" aria-label="Pagination">
    {prevUrl ? (
      <a href={prevUrl} class="px-4 py-2 text-sm font-medium text-[var(--color-ink-soft)] bg-white border border-[var(--color-rule)] rounded-md hover:bg-[var(--color-surface-soft)] no-underline">
        ← Newer
      </a>
    ) : (
      <span class="px-4 py-2 text-sm font-medium text-[var(--color-muted)] bg-[var(--color-surface-soft)] border border-[var(--color-rule)] rounded-md cursor-not-allowed opacity-50">
        ← Newer
      </span>
    )}
    <span class="text-sm text-[var(--color-muted)]">Page {currentPage} of {lastPage}</span>
    {nextUrl ? (
      <a href={nextUrl} class="px-4 py-2 text-sm font-medium text-[var(--color-ink-soft)] bg-white border border-[var(--color-rule)] rounded-md hover:bg-[var(--color-surface-soft)] no-underline">
        Older →
      </a>
    ) : (
      <span class="px-4 py-2 text-sm font-medium text-[var(--color-muted)] bg-[var(--color-surface-soft)] border border-[var(--color-rule)] rounded-md cursor-not-allowed opacity-50">
        Older →
      </span>
    )}
  </nav>
)}
