---
interface Props {
  label: string;
}
const { label } = Astro.props;
---
<div class="flex items-baseline mb-6">
  <span class="font-[family-name:var(--font-mono)] text-xs font-medium tracking-[0.14em] uppercase text-[var(--color-muted)] whitespace-nowrap">
    {label}
  </span>
  <span class="h-px flex-grow ml-5 bg-[var(--color-rule-soft)]"></span>
</div>
