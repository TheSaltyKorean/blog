---
/**
 * Google Analytics 4.
 *
 * Property "The Salty Korean - GA4" (364271200), stream 4895532335. The
 * property was created during the Jekyll era but the tag was never carried
 * across to Astro, so it recorded nothing until 2026-08-07.
 *
 * Rendered only in production builds so `npm run dev` does not write test
 * traffic into the property. Deliberately not included in RedirectStub.astro —
 * redirect hops are not pageviews worth counting.
 */
const MEASUREMENT_ID = 'G-MFKMPMJ07G';
const enabled = import.meta.env.PROD;
---
{
  enabled && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${MEASUREMENT_ID}`} />
      <script is:inline define:vars={{ MEASUREMENT_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', MEASUREMENT_ID);
      </script>
    </>
  )
}
