---
/**
 * Client-side redirect stub, matching the markup that
 * scripts/generate-redirects.mjs emits for legacy URLs. GitHub Pages serves
 * static files only, so a meta-refresh plus a canonical pointing at the real
 * URL is the available equivalent of a 301.
 */
interface Props {
  to: string;
}

const { to } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={`https://thesaltykorean.com${to}`} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>Redirecting to <a href={to}>{to}</a>…</p>
  </body>
</html>
