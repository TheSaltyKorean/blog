---
import { siteConfig } from '../data/siteConfig';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Present on post pages; switches og:type to article and adds article:* tags. */
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    author?: string;
    tags?: string[];
    section?: string;
  };
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  canonical,
  ogImage = siteConfig.ogImage,
  noindex = false,
  article,
} = Astro.props;

// YAML folded scalars (`meta_description: >`) carry a trailing newline, and
// multi-line values keep their internal ones. Both end up inside the rendered
// attribute, so collapse whitespace before emitting.
const clean = (value: string) => String(value).replace(/\s+/g, ' ').trim();

// Bing flags "many of your page titles are too short" — 61 of them were under
// 30 characters ("Airplanes", "Letting Go"). Suffixing the site name gives the
// SERP entry both length and a brand signal. Guarded two ways: skipped when
// the title already names the site (so "About Randy Walker" does not become
// "About Randy Walker — Randy Walker"), and skipped past 60 characters so we
// never push a good title into truncation.
const withSiteName = (value: string) => {
  const base = clean(value);
  if (base.toLowerCase().includes(siteConfig.title.toLowerCase())) return base;
  const suffixed = `${base} — ${siteConfig.title}`;
  return suffixed.length > 60 ? base : suffixed;
};

const metaTitle = withSiteName(title);
const metaDescription = clean(description);

const canonicalUrl = canonical
  ? new URL(canonical, siteConfig.url).href
  : new URL(Astro.url.pathname, siteConfig.url).href;
const resolvedOgImage = new URL(ogImage, siteConfig.url).href;
---
<title>{metaTitle}</title>
<meta name="title" content={metaTitle} />
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<meta name="theme-color" content="#1f5f74" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} — RSS`} href="/feed.xml" />

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={metaTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:site_name" content={siteConfig.title} />
{article && (
  <>
    <meta property="article:published_time" content={article.publishedTime} />
    <meta property="article:modified_time" content={article.modifiedTime || article.publishedTime} />
    <meta property="article:author" content={article.author || siteConfig.author.name} />
    {article.section && <meta property="article:section" content={article.section} />}
    {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  </>
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={`@${siteConfig.social.twitter}`} />
<meta name="twitter:creator" content={`@${siteConfig.social.twitter}`} />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={metaTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={resolvedOgImage} />
